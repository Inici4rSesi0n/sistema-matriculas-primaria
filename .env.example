# Configuración local de PostgreSQL para WiredAcademy
# Copiar a .env y rellenar con valores reales. NO commitear .env.

WIREDACADEMY_DB_NAME=wiredacademy
WIREDACADEMY_DB_USER=wiredacademy_app
WIREDACADEMY_DB_PASSWORD=cambiar_esta_password
WIREDACADEMY_DB_PORT=5433
WIREDACADEMY_DB_HOST=localhost
WIREDACADEMY_LOG_DIR=./logs
