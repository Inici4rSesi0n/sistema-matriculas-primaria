<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.VBox?>

<TabPane fx:id="tabPaneCatalogos" xmlns="http://javafx.com/javafx/23.0.1"
         xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="presentacion.controlador.TabCatalogosController"
         styleClass="seccion-tabpane" tabClosingPolicy="UNAVAILABLE">
    <tabs>
        <Tab fx:id="tabAsignaturas" text="Asignaturas">
            <fx:include source="tab_asignaturas.fxml" />
        </Tab>
        <Tab fx:id="tabPeriodos" text="Periodos">
            <fx:include source="tab_periodos.fxml" />
        </Tab>
        <Tab fx:id="tabAulas" text="Aulas">
            <fx:include source="tab_aulas.fxml" />
        </Tab>
        <Tab fx:id="tabGrupos" text="Grupos">
            <fx:include source="tab_grupos.fxml" />
        </Tab>
        <Tab fx:id="tabRecreos" text="Recreos">
            <fx:include source="tab_recreos.fxml" />
        </Tab>
        <Tab fx:id="tabGrados" text="Grados">
            <fx:include source="tab_grados.fxml" />
        </Tab>
        <Tab fx:id="tabTurnos" text="Turnos">
            <fx:include source="tab_turnos.fxml" />
        </Tab>
    </tabs>
</TabPane>
