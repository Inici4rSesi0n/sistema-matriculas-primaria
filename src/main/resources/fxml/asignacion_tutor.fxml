<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="presentacion.controlador.AsignacionTutorController"
      alignment="CENTER" spacing="20.0" styleClass="app-background" prefWidth="500.0" prefHeight="350.0">
    
    <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>

    <Label text="Asignar Tutor a Grupo" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #F8FAFC; -fx-effect: dropshadow(gaussian, rgba(0,210,255,0.2), 10, 0.1, 0, 0);"/>
    <Separator styleClass="formulario-separator" style="-fx-pref-width: 400.0;"/>

    <VBox spacing="10.0" maxWidth="400.0">
        <Label text="Docente:" styleClass="formulario-label" />
        <ComboBox fx:id="cmbDocente" promptText="Seleccione un docente" styleClass="formulario-input" maxWidth="1.0E8"/>
        
        <Label text="Grupo:" styleClass="formulario-label" />
        <ComboBox fx:id="cmbGrupo" promptText="Seleccione un grupo" styleClass="formulario-input" maxWidth="1.0E8"/>
    </VBox>

    <Region VBox.vgrow="ALWAYS" />

    <HBox alignment="CENTER_RIGHT" spacing="15.0" maxWidth="400.0" style="-fx-padding: 20 0 0 0;">
        <Button text="Cancelar" styleClass="boton-morado-suave" onAction="#handleCancelar" prefWidth="120.0"/>
        <Button text="Asignar Tutor" styleClass="boton-primario" onAction="#handleGuardar" prefWidth="120.0"/>
    </HBox>
</VBox>
