<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="root" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="presentacion.controlador.TabTutoriasController">
    <center>
        <VBox spacing="15.0" style="-fx-padding: 20px;">
            <HBox styleClass="crud-header" alignment="CENTER_LEFT">
                <Label text="Asignación de Tutores a Grupos" styleClass="crud-title" style="-fx-font-size: 20px;"/>
            </HBox>
            <HBox spacing="15.0" alignment="CENTER_LEFT" style="-fx-padding: 0 0 10 0;">
                <ComboBox fx:id="cmbDocenteTutor" promptText="Seleccione un docente" styleClass="formulario-input" prefWidth="300.0" />
                <ComboBox fx:id="cmbGrupoTutor" promptText="Seleccione un grupo" styleClass="formulario-input" prefWidth="300.0" />
                <Button fx:id="btnAsignarTutor" text="+ Asignar Tutor" styleClass="boton-primario" onAction="#handleAsignarTutor" />
            </HBox>
            <VBox styleClass="tabla-wrapper" VBox.vgrow="ALWAYS">
                <TableView fx:id="tablaTutores" styleClass="seccion-tabla" VBox.vgrow="ALWAYS">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colGrupoTutor" text="Grupo" prefWidth="250.0" />
                        <TableColumn fx:id="colDocenteTutor" text="Docente Tutor" prefWidth="250.0" />
                        <TableColumn fx:id="colAccionesTutor" text="Acciones" prefWidth="100.0" />
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>
