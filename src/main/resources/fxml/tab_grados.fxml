<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="presentacion.controlador.TabGradosController">
    <center>
        <VBox spacing="15.0">
            <HBox alignment="CENTER_LEFT">
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnNuevoGrado" text="+ Nuevo Grado" styleClass="boton-primario" onAction="#handleNuevoGrado" />
            </HBox>
            <VBox styleClass="tabla-wrapper" VBox.vgrow="ALWAYS">
                <TableView fx:id="tablaGrados" styleClass="seccion-tabla" VBox.vgrow="ALWAYS">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colNumGrado" text="N°" prefWidth="50.0" />
                        <TableColumn fx:id="colNombreGrado" text="Nombre" prefWidth="200.0" />
                        <TableColumn fx:id="colNivelGrado" text="Nivel" prefWidth="150.0" />
                        <TableColumn fx:id="colAccionesGrado" text="Acciones" prefWidth="160.0" />
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
    <right>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox fx:id="panelFormularioGrado" styleClass="formulario-panel" visible="false" managed="false" spacing="15.0" prefWidth="380.0">
                <padding><Insets top="30.0" right="30.0" bottom="30.0" left="30.0" /></padding>
                <Label styleClass="formulario-title" text="Datos del Grado" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #F8FAFC;"/>
                <Separator styleClass="formulario-separator" />
                <Label text="Nombre:" styleClass="formulario-label" />
                <TextField fx:id="txtNombreGrado" promptText="Ej. 1er Grado" styleClass="formulario-input" />
                <Label text="Nivel:" styleClass="formulario-label" />
                <TextField fx:id="txtNivelGrado" promptText="Ej. Primaria" styleClass="formulario-input" />
                <Region VBox.vgrow="ALWAYS" />
                <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-padding: 20 0 0 0;">
                    <Button fx:id="btnCancelarGrado" text="Cancelar" styleClass="boton-morado-suave" onAction="#handleCancelarGrado" prefWidth="120.0" />
                    <Button fx:id="btnGuardarGrado" text="Guardar" styleClass="boton-primario" onAction="#handleGuardarGrado" prefWidth="120.0" />
                </HBox>
            </VBox>
        </ScrollPane>
    </right>
</BorderPane>
