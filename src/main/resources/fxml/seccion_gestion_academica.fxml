<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="presentacion.controlador.SeccionGestionAcademicaController"
            styleClass="app-background">
    
    <center>
        <VBox spacing="20.0" style="-fx-padding: 30px;">
            <HBox styleClass="crud-header" alignment="CENTER_LEFT">
                <Label styleClass="crud-title" text="Gestión Académica" />
                <Region HBox.hgrow="ALWAYS" />
                <ComboBox fx:id="cmbCategoria" promptText="Seleccione categoría" styleClass="formulario-input" prefWidth="250.0" />
            </HBox>
            
            <StackPane fx:id="contenedorCategorias" VBox.vgrow="ALWAYS" styleClass="tabla-wrapper">
                <fx:include fx:id="tabPaneCatalogos" source="tab_catalogos.fxml" />
                <fx:include fx:id="tabPaneAsignaciones" source="tab_asignaciones.fxml" />
                <fx:include fx:id="tabPaneTutorias" source="tab_tutorias.fxml" />
                <fx:include fx:id="tabPaneCoordinacion" source="tab_coordinacion.fxml" />
                <fx:include fx:id="tabPaneHorarios" source="tab_horarios.fxml" />
            </StackPane>
        </VBox>
    </center>
</BorderPane>
