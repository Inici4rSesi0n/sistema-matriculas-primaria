<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="presentacion.controlador.TabAulasController">
    <center>
        <VBox spacing="15.0">
            <HBox alignment="CENTER_LEFT">
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnNuevaAula" text="+ Nueva Aula" styleClass="boton-primario" onAction="#handleNuevaAula" />
            </HBox>
            <VBox styleClass="tabla-wrapper" VBox.vgrow="ALWAYS">
                <TableView fx:id="tablaAulas" styleClass="seccion-tabla" VBox.vgrow="ALWAYS">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colNumAula" text="N°" prefWidth="50.0" />
                        <TableColumn fx:id="colNombreAula" text="Nombre" prefWidth="150.0" />
                        <TableColumn fx:id="colCapacidadAula" text="Capacidad" prefWidth="80.0" />
                        <TableColumn fx:id="colUbicacionAula" text="Ubicación" prefWidth="120.0" />
                        <TableColumn fx:id="colTipoAula" text="Tipo" prefWidth="100.0" />
                        <TableColumn fx:id="colModalidadAula" text="Modalidad" prefWidth="100.0" />
                        <TableColumn fx:id="colAccionesAula" text="Acciones" prefWidth="160.0" />
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
    <right>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox fx:id="panelFormularioAula" styleClass="formulario-panel" visible="false" managed="false" spacing="15.0" prefWidth="380.0">
                <padding><Insets top="30.0" right="30.0" bottom="30.0" left="30.0" /></padding>
                <Label styleClass="formulario-title" text="Datos del Aula" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #F8FAFC;"/>
                <Separator styleClass="formulario-separator" />
                <Label text="Nombre:" styleClass="formulario-label" />
                <TextField fx:id="txtNombreAula" promptText="Ej. Aula 101" styleClass="formulario-input" />
                <Label text="Capacidad:" styleClass="formulario-label" />
                <TextField fx:id="txtCapacidadAula" promptText="Ej. 40" styleClass="formulario-input" />
                <Label text="Ubicación:" styleClass="formulario-label" />
                <TextField fx:id="txtUbicacionAula" promptText="Ej. Pabellón A" styleClass="formulario-input" />
                <Label text="Tipo:" styleClass="formulario-label" />
                <TextField fx:id="txtTipoAula" promptText="Ej. Laboratorio" styleClass="formulario-input" />
                <Label text="Modalidad:" styleClass="formulario-label" />
                <ComboBox fx:id="cmbModalidadAula" promptText="Seleccione una modalidad" styleClass="formulario-input" maxWidth="1.0E8"/>
                <Region VBox.vgrow="ALWAYS" />
                <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-padding: 20 0 0 0;">
                    <Button fx:id="btnCancelarAula" text="Cancelar" styleClass="boton-morado-suave" onAction="#handleCancelarAula" prefWidth="120.0" />
                    <Button fx:id="btnGuardarAula" text="Guardar" styleClass="boton-primario" onAction="#handleGuardarAula" prefWidth="120.0" />
                </HBox>
            </VBox>
        </ScrollPane>
    </right>
</BorderPane>
