<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="presentacion.controlador.TabAulasController">
    <top>
        <HBox styleClass="seccion-toolbar" alignment="CENTER_LEFT">
            <Button fx:id="btnNuevaAula"
                    text="+ Nueva Aula"
                    styleClass="boton-primario"
                    onAction="#handleNuevaAula" />
        </HBox>
    </top>
    <center>
        <TableView fx:id="tablaAulas" styleClass="seccion-tabla">
            <columns>
                <TableColumn fx:id="colNumAula" text="N°" prefWidth="50.0" styleClass="col-center" />
                <TableColumn fx:id="colNombreAula" text="Nombre" prefWidth="150.0" />
                <TableColumn fx:id="colCapacidadAula" text="Capacidad" prefWidth="80.0" styleClass="col-center" />
                <TableColumn fx:id="colUbicacionAula" text="Ubicación" prefWidth="120.0" />
                <TableColumn fx:id="colTipoAula" text="Tipo" prefWidth="100.0" />
                <TableColumn fx:id="colModalidadAula" text="Modalidad" prefWidth="100.0" styleClass="col-center" />
                <TableColumn fx:id="colAccionesAula" text="Acciones" prefWidth="160.0" styleClass="col-center" />
            </columns>
        </TableView>
    </center>
    <right>
        <VBox fx:id="panelFormularioAula" styleClass="formulario-panel" visible="false" managed="false" spacing="15.0" prefWidth="420.0">
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
            </padding>
            <Label styleClass="formulario-title" text="Aula" />
            <Separator styleClass="formulario-separator" />
            <Label text="Nombre:" styleClass="formulario-label" />
            <TextField fx:id="txtNombreAula" promptText="Nombre del aula" styleClass="formulario-input" />
            <Label text="Capacidad:" styleClass="formulario-label" />
            <TextField fx:id="txtCapacidadAula" promptText="Número de alumnos" styleClass="formulario-input" />
            <Label text="Ubicación:" styleClass="formulario-label" />
            <TextField fx:id="txtUbicacionAula" promptText="Edificio/Piso" styleClass="formulario-input" />
            <Label text="Tipo:" styleClass="formulario-label" />
            <TextField fx:id="txtTipoAula" promptText="Teórica/Laboratorio" styleClass="formulario-input" />
            <Label text="Modalidad:" styleClass="formulario-label" />
            <ComboBox fx:id="cmbModalidadAula" promptText="Seleccione una modalidad" styleClass="formulario-input" />
            <Region VBox.vgrow="ALWAYS" />
            <HBox alignment="CENTER_RIGHT" spacing="15.0">
                <Button fx:id="btnCancelarAula" text="Cancelar" styleClass="boton-secundario" onAction="#handleCancelarAula" />
                <Button fx:id="btnGuardarAula" text="Guardar" styleClass="boton-primario" onAction="#handleGuardarAula" />
            </HBox>
        </VBox>
    </right>
</BorderPane>
