<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="presentacion.controlador.TabTurnosController">
    <center>
        <VBox spacing="15.0">
            <HBox alignment="CENTER_LEFT">
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnNuevoTurno" text="+ Nuevo Turno" styleClass="boton-primario" onAction="#handleNuevoTurno" />
            </HBox>
            <VBox styleClass="tabla-wrapper" VBox.vgrow="ALWAYS">
                <TableView fx:id="tablaTurnos" styleClass="seccion-tabla" VBox.vgrow="ALWAYS">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colNumTurno" text="N°" prefWidth="50.0" />
                        <TableColumn fx:id="colNombreTurno" text="Nombre" prefWidth="300.0" />
                        <TableColumn fx:id="colAccionesTurno" text="Acciones" prefWidth="160.0" />
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
    <right>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox fx:id="panelFormularioTurno" styleClass="formulario-panel" visible="false" managed="false" spacing="15.0" prefWidth="380.0">
                <padding><Insets top="30.0" right="30.0" bottom="30.0" left="30.0" /></padding>
                <Label styleClass="formulario-title" text="Datos del Turno" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #F8FAFC;"/>
                <Separator styleClass="formulario-separator" />
                <Label text="Nombre:" styleClass="formulario-label" />
                <TextField fx:id="txtNombreTurno" promptText="Ej. Mañana" styleClass="formulario-input" />
                <Region VBox.vgrow="ALWAYS" />
                <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-padding: 20 0 0 0;">
                    <Button fx:id="btnCancelarTurno" text="Cancelar" styleClass="boton-morado-suave" onAction="#handleCancelarTurno" prefWidth="120.0" />
                    <Button fx:id="btnGuardarTurno" text="Guardar" styleClass="boton-primario" onAction="#handleGuardarTurno" prefWidth="120.0" />
                </HBox>
            </VBox>
        </ScrollPane>
    </right>
</BorderPane>
