<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="presentacion.controlador.TabAsignaturasController">
    <center>
        <VBox spacing="15.0" style="-fx-padding: 20px;">
            <HBox styleClass="crud-header" alignment="CENTER_LEFT">
                <Label text="Listado de Asignaturas" styleClass="crud-title" style="-fx-font-size: 20px;"/>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnNuevaAsignatura" text="+ Nueva Asignatura" styleClass="boton-primario" onAction="#handleNuevaAsignatura" />
            </HBox>
            <VBox styleClass="tabla-wrapper" VBox.vgrow="ALWAYS">
                <TableView fx:id="tablaAsignaturas" styleClass="seccion-tabla" VBox.vgrow="ALWAYS">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colNumAsignatura" text="N°" prefWidth="60.0" />
                        <TableColumn fx:id="colNombreAsignatura" text="Nombre de la Asignatura" prefWidth="400.0" />
                        <TableColumn fx:id="colAccionesAsignatura" text="Acciones" prefWidth="200.0" />
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
    <right>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox fx:id="panelFormularioAsignatura" styleClass="formulario-panel" visible="false" managed="false" spacing="15.0" prefWidth="380.0">
                <padding><Insets top="30.0" right="30.0" bottom="30.0" left="30.0" /></padding>
                <Label styleClass="formulario-title" text="Datos de la Asignatura" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #F8FAFC;"/>
                <Separator styleClass="formulario-separator" />
                <Label text="Nombre:" styleClass="formulario-label" />
                <TextField fx:id="txtNombreAsignatura" promptText="Ej. Matemática Avanzada" styleClass="formulario-input" />
                <Region VBox.vgrow="ALWAYS" />
                <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-padding: 20 0 0 0;">
                    <Button fx:id="btnCancelarAsignatura" text="Cancelar" styleClass="boton-morado-suave" onAction="#handleCancelarAsignatura" prefWidth="120.0" />
                    <Button fx:id="btnGuardarAsignatura" text="Guardar" styleClass="boton-primario" onAction="#handleGuardarAsignatura" prefWidth="120.0" />
                </HBox>
            </VBox>
        </ScrollPane>
    </right>
</BorderPane>
