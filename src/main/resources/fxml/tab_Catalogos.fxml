                        <columns>
                            <TableColumn fx:id="colNumGrado" text="N°" prefWidth="50.0" styleClass="col-center" />
                            <TableColumn fx:id="colNombreGrado" text="Nombre" prefWidth="200.0" />
                            <TableColumn fx:id="colNivelGrado" text="Nivel" prefWidth="150.0" />
                            <TableColumn fx:id="colAccionesGrado" text="Acciones" prefWidth="160.0" styleClass="col-center" />
