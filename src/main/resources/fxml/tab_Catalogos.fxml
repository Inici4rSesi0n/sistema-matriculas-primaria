                            <TableColumn fx:id="colNombreTurno" text="Nombre" prefWidth="300.0" />
                            <TableColumn fx:id="colAccionesTurno" text="Acciones" prefWidth="160.0" styleClass="col-center" />
                        </columns>
                    </TableView>
                </center>
                <right>
                    <VBox fx:id="panelFormularioTurno" styleClass="formulario-panel" visible="false" managed="false" spacing="15.0" prefWidth="420.0">
                        <padding>
                            <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
                        </padding>
                        <Label styleClass="formulario-title" text="Turno" />
                        <Separator styleClass="formulario-separator" />
                        <Label text="Nombre:" styleClass="formulario-label" />
