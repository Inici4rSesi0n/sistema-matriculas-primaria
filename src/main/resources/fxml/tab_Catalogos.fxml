                            <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
                        </padding>
                        <Label styleClass="formulario-title" text="Recreo" />
                        <Separator styleClass="formulario-separator" />
                        <Label text="Día:" styleClass="formulario-label" />
                        <ComboBox fx:id="cmbDiaRecreo" promptText="Seleccione un día" styleClass="formulario-input" />
                        <Label text="Periodo:" styleClass="formulario-label" />
                        <ComboBox fx:id="cmbPeriodoRecreo" promptText="Seleccione un periodo" styleClass="formulario-input" />
                        <Label text="Hora Inicio:" styleClass="formulario-label" />
                        <TextField fx:id="txtInicioRecreo" promptText="HH:mm" styleClass="formulario-input" />
                        <Label text="Hora Fin:" styleClass="formulario-label" />
                        <TextField fx:id="txtFinRecreo" promptText="HH:mm" styleClass="formulario-input" />
                        <Label text="Descripción:" styleClass="formulario-label" />
                        <TextField fx:id="txtDescripcionRecreo" promptText="Recreo" styleClass="formulario-input" />
                        <Region VBox.vgrow="ALWAYS" />
                        <HBox alignment="CENTER_RIGHT" spacing="15.0">
                            <Button fx:id="btnCancelarRecreo" text="Cancelar" styleClass="boton-secundario" onAction="#handleCancelarRecreo" />
                            <Button fx:id="btnGuardarRecreo" text="Guardar" styleClass="boton-primario" onAction="#handleGuardarRecreo" />
                        </HBox>
                    </VBox>
                </right>
            </BorderPane>
        </Tab>

        <Tab fx:id="tabGrados" text="Grados" closable="false">
