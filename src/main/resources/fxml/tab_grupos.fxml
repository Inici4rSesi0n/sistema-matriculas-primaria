<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="presentacion.controlador.TabGruposController">
    <center>
        <VBox spacing="15.0">
            <HBox alignment="CENTER_LEFT">
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnNuevoGrupo" text="+ Nuevo Grupo" styleClass="boton-primario" onAction="#handleNuevoGrupo" />
            </HBox>
            <VBox styleClass="tabla-wrapper" VBox.vgrow="ALWAYS">
                <TableView fx:id="tablaGrupos" styleClass="seccion-tabla" VBox.vgrow="ALWAYS">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colNumGrupo" text="N°" prefWidth="50.0" />
                        <TableColumn fx:id="colNombreGrupo" text="Nombre" prefWidth="200.0" />
                        <TableColumn fx:id="colGradoGrupo" text="Grado" prefWidth="150.0" />
                        <TableColumn fx:id="colAccionesGrupo" text="Acciones" prefWidth="160.0" />
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
    <right>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox fx:id="panelFormularioGrupo" styleClass="formulario-panel" visible="false" managed="false" spacing="15.0" prefWidth="380.0">
                <padding><Insets top="30.0" right="30.0" bottom="30.0" left="30.0" /></padding>
                <Label styleClass="formulario-title" text="Datos del Grupo" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #F8FAFC;"/>
                <Separator styleClass="formulario-separator" />
                <Label text="Nombre:" styleClass="formulario-label" />
                <TextField fx:id="txtNombreGrupo" promptText="Ej. 1A" styleClass="formulario-input" />
                <Label text="Grado:" styleClass="formulario-label" />
                <ComboBox fx:id="cmbGradoGrupo" promptText="Seleccione un grado" styleClass="formulario-input" maxWidth="1.0E8"/>
                <Region VBox.vgrow="ALWAYS" />
                <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-padding: 20 0 0 0;">
                    <Button fx:id="btnCancelarGrupo" text="Cancelar" styleClass="boton-morado-suave" onAction="#handleCancelarGrupo" prefWidth="120.0" />
                    <Button fx:id="btnGuardarGrupo" text="Guardar" styleClass="boton-primario" onAction="#handleGuardarGrupo" prefWidth="120.0" />
                </HBox>
            </VBox>
        </ScrollPane>
    </right>
</BorderPane>
