<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="root" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="presentacion.controlador.TabHorariosController">
    <center>
        <VBox spacing="15.0" style="-fx-padding: 20px;">
            <HBox styleClass="crud-header" alignment="CENTER_LEFT">
                <Label text="Listado de Clases" styleClass="crud-title" style="-fx-font-size: 20px;"/>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnVerHorario" text="📅 Ver Horario" styleClass="boton-secundario" onAction="#handleVerHorario" style="-fx-margin: 0 15 0 0;" />
                <Button fx:id="btnNuevaClase" text="+ Nueva Clase" styleClass="boton-primario" onAction="#handleNuevaClase" />
            </HBox>
            <VBox styleClass="tabla-wrapper" VBox.vgrow="ALWAYS">
                <TableView fx:id="tablaClases" styleClass="seccion-tabla" VBox.vgrow="ALWAYS">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colNumClase" text="N°" prefWidth="50.0" />
                        <TableColumn fx:id="colDiaClase" text="Día" prefWidth="80.0" />
                        <TableColumn fx:id="colInicioClase" text="Inicio" prefWidth="70.0" />
                        <TableColumn fx:id="colFinClase" text="Fin" prefWidth="70.0" />
                        <TableColumn fx:id="colAsignaturaClase" text="Asignatura" prefWidth="120.0" />
                        <TableColumn fx:id="colDocenteClase" text="Docente" prefWidth="120.0" />
                        <TableColumn fx:id="colGrupoClase" text="Grupo" prefWidth="90.0" />
                        <TableColumn fx:id="colAulaClase" text="Aula" prefWidth="80.0" />
                        <TableColumn fx:id="colPeriodoClase" text="Periodo" prefWidth="80.0" />
                        <TableColumn fx:id="colAccionesClase" text="Acciones" prefWidth="140.0" />
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
    <right>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox fx:id="panelFormularioClase" styleClass="formulario-panel" visible="false" managed="false" spacing="15.0" prefWidth="380.0">
                <padding><Insets top="30.0" right="30.0" bottom="30.0" left="30.0" /></padding>
                <Label styleClass="formulario-title" text="Datos de la Clase" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #F8FAFC;"/>
                <Separator styleClass="formulario-separator" />
                <Label text="Día:" styleClass="formulario-label" />
                <ComboBox fx:id="cmbDiaClase" promptText="Seleccione un día" styleClass="formulario-input" maxWidth="1.0E8"/>
                <HBox spacing="10.0">
                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                        <Label text="Hora Inicio:" styleClass="formulario-label" />
                        <TextField fx:id="txtInicioClase" promptText="HH:mm" styleClass="formulario-input" />
                    </VBox>
                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                        <Label text="Hora Fin:" styleClass="formulario-label" />
                        <TextField fx:id="txtFinClase" promptText="HH:mm" styleClass="formulario-input" />
                    </VBox>
                </HBox>
                <Label text="Asignatura:" styleClass="formulario-label" />
                <ComboBox fx:id="cmbAsignaturaClase" promptText="Seleccione una asignatura" styleClass="formulario-input" maxWidth="1.0E8"/>
                <Label text="Docente:" styleClass="formulario-label" />
                <ComboBox fx:id="cmbDocenteClase" promptText="Seleccione un docente" styleClass="formulario-input" maxWidth="1.0E8"/>
                <Label text="Grupo:" styleClass="formulario-label" />
                <ComboBox fx:id="cmbGrupoClase" promptText="Seleccione un grupo" styleClass="formulario-input" maxWidth="1.0E8"/>
                <Label text="Aula:" styleClass="formulario-label" />
                <ComboBox fx:id="cmbAulaClase" promptText="Seleccione un aula" styleClass="formulario-input" maxWidth="1.0E8"/>
                <Label text="Periodo:" styleClass="formulario-label" />
                <ComboBox fx:id="cmbPeriodoClase" promptText="Seleccione un periodo" styleClass="formulario-input" maxWidth="1.0E8"/>
                <Region VBox.vgrow="ALWAYS" />
                <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-padding: 20 0 0 0;">
                    <Button fx:id="btnCancelarClase" text="Cancelar" styleClass="boton-morado-suave" onAction="#handleCancelarClase" prefWidth="120.0" />
                    <Button fx:id="btnGuardarClase" text="Guardar" styleClass="boton-primario" onAction="#handleGuardarClase" prefWidth="120.0" />
                </HBox>
            </VBox>
        </ScrollPane>
    </right>
</BorderPane>
