<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="presentacion.controlador.DashboardController" styleClass="app-background">
    
    <top>
        <HBox styleClass="header-dashboard" alignment="CENTER_RIGHT" spacing="15.0">
            <Label fx:id="lblUsuarioHeader" style="-fx-text-fill: #F8FAFC; -fx-font-weight: bold; -fx-padding: 0 20px 0 0;" text="Usuario"/>
            <Button fx:id="btnVolverInicio" text="Volver al Menú Principal" styleClass="boton-morado-suave" onAction="#handleVolverInicio" style="-fx-padding: 6px 15px; -fx-font-size: 12px;"/>
        </HBox>
    </top>
    
    <left>
        <VBox styleClass="sidebar">
            <VBox alignment="CENTER" spacing="2.0" styleClass="sidebar-branding">
                <Label text="WiredAcademy" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #F8FAFC; -fx-effect: dropshadow(gaussian, rgba(0,210,255,0.3), 10, 0.1, 0, 0);"/>
                <Label text="Sistema Educativo Digital" style="-fx-font-size: 10px; -fx-text-fill: #A78BFA; -fx-letter-spacing: 1px;"/>
            </VBox>
            
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                <VBox spacing="2.0">
                    <Label text="MI ÁREA PERSONAL" styleClass="sidebar-section-title"/>
                    <!-- Mis Cursos: Icono de Libro -->
                    <Button styleClass="sidebar-btn"><graphic><HBox alignment="CENTER_LEFT" spacing="15.0"><SVGPath content="M18 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 4h5v8l-2.5-1.5L6 12V4z" styleClass="svg-icon-muted"/><Label text="Mis Cursos" styleClass="sidebar-label"/></HBox></graphic></Button>
                    <!-- Mi Horario: Icono de Calendario -->
                    <Button styleClass="sidebar-btn"><graphic><HBox alignment="CENTER_LEFT" spacing="15.0"><SVGPath content="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11z" styleClass="svg-icon-muted"/><Label text="Mi Horario" styleClass="sidebar-label"/></HBox></graphic></Button>
                    <!-- Calificaciones: Icono de Gráfico de Barras -->
                    <Button styleClass="sidebar-btn"><graphic><HBox alignment="CENTER_LEFT" spacing="15.0"><SVGPath content="M5 9.2h3V19H5V9.2zM10.6 5h2.8v14h-2.8V5zm5.6 8H19v6h-2.8v-6z" styleClass="svg-icon-muted"/><Label text="Calificaciones" styleClass="sidebar-label"/></HBox></graphic></Button>
                    <!-- Subir Material: Icono de Nube/Subida -->
                    <Button styleClass="sidebar-btn"><graphic><HBox alignment="CENTER_LEFT" spacing="15.0"><SVGPath content="M9 16h6v-6h4l-7-7-7 7h4zm-4 2h14v2H5z" styleClass="svg-icon-muted"/><Label text="Subir Material" styleClass="sidebar-label"/></HBox></graphic></Button>
                    <!-- Registrar Asistencia: Icono de Portapapeles/Checklist -->
                    <Button styleClass="sidebar-btn"><graphic><HBox alignment="CENTER_LEFT" spacing="15.0"><SVGPath content="M19 3h-4.18C14.4 1.84 13.3 1 12 1c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm2 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z" styleClass="svg-icon-muted"/><Label text="Registrar Asistencia" styleClass="sidebar-label"/></HBox></graphic></Button>

                    <Label text="GESTIÓN DE TRÁMITES" styleClass="sidebar-section-title"/>
                    <!-- Trámites: Icono de Bandeja de Entrada -->
                    <Button styleClass="sidebar-btn"><graphic><HBox alignment="CENTER_LEFT" spacing="15.0"><SVGPath content="M19 3H4.99c-1.11 0-1.98.89-1.98 2L3 19c0 1.1.88 2 1.99 2H19c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 12h-4c0 1.66-1.35 3-3 3s-3-1.34-3-3H4.99V5H19v10z" styleClass="svg-icon-muted"/><Label text="Trámites" styleClass="sidebar-label"/></HBox></graphic></Button>
                    <!-- Matrícula: Icono de Tarjeta de Identificación -->
                    <Button styleClass="sidebar-btn" onAction="#cargarSeccion" userData="seccion_matricula"><graphic><HBox alignment="CENTER_LEFT" spacing="15.0"><SVGPath content="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z" styleClass="svg-icon-muted"/><Label text="Matrícula" styleClass="sidebar-label"/></HBox></graphic></Button>

                    <Label text="ADMINISTRACIÓN DEL SISTEMA" styleClass="sidebar-section-title"/>
                    <!-- Gestión de Usuarios: Icono de Grupo -->
                    <Button styleClass="sidebar-btn" onAction="#cargarSeccion" userData="seccion_gestion_usuarios"><graphic><HBox alignment="CENTER_LEFT" spacing="15.0"><SVGPath content="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" styleClass="svg-icon-muted"/><Label text="Gestión de Usuarios" styleClass="sidebar-label"/></HBox></graphic></Button>
                    <!-- Gestión Académica: Icono de Escuela (Birrete) -->
                    <Button styleClass="sidebar-btn" onAction="#cargarSeccion" userData="seccion_gestion_academica"><graphic><HBox alignment="CENTER_LEFT" spacing="15.0"><SVGPath content="M12 3L1 9l4 2.18v6L12 21l7-3.82v-6l2-1.09V17h2V9L12 3zm6.82 6L12 12.72 5.18 9 12 5.28 18.82 9zM17 15.99l-5 2.73-5-2.73v-3.72l5 2.73 5-2.73v3.72z" styleClass="svg-icon-muted"/><Label text="Gestión Académica" styleClass="sidebar-label"/></HBox></graphic></Button>
                    <!-- Reportes: Icono de Gráfico Circular -->
                    <Button styleClass="sidebar-btn"><graphic><HBox alignment="CENTER_LEFT" spacing="15.0"><SVGPath content="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z" styleClass="svg-icon-muted"/><Label text="Reportes" styleClass="sidebar-label"/></HBox></graphic></Button>
                    <!-- Configuración: Icono de Engranaje -->
                    <Button styleClass="sidebar-btn"><graphic><HBox alignment="CENTER_LEFT" spacing="15.0"><SVGPath content="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.06-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.73,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.06,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.49-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z" styleClass="svg-icon-muted"/><Label text="Configuración" styleClass="sidebar-label"/></HBox></graphic></Button>
                    <Region VBox.vgrow="ALWAYS" style="-fx-min-height: 20px;"/>
                </VBox>
            </ScrollPane>
        </VBox>
    </left>
    
    <center>
        <StackPane fx:id="contenedorCentral" styleClass="center-dashboard" style="-fx-padding: 40px;">
            <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" style="-fx-background-color: transparent; -fx-background: transparent;">
                <VBox alignment="TOP_LEFT" spacing="40.0" maxWidth="1100.0">
                    
                    <VBox alignment="CENTER_LEFT" spacing="8.0">
                        <Label text="Hola de nuevo, Inici4rSesi0n" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #F8FAFC; -fx-effect: dropshadow(gaussian, rgba(0,210,255,0.2), 15, 0.1, 0, 0);"/>
                        <Label text="Aquí tienes un vistazo rápido a tu ecosistema educativo hoy." style="-fx-font-size: 16px; -fx-text-fill: #A78BFA;"/>
                    </VBox>

                    <GridPane hgap="25.0" vgap="25.0">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                        </columnConstraints>
                        
                        <VBox styleClass="kpi-card" GridPane.columnIndex="0" spacing="15.0">
                            <HBox spacing="15.0" alignment="CENTER_LEFT">
                                <SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" styleClass="svg-icon-cyan-large"/>
                                <Label text="Estudiantes" style="-fx-text-fill: #94A3B8; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                            </HBox>
                            <Label fx:id="lblNumEstudiantes" text="0" style="-fx-text-fill: #F8FAFC; -fx-font-size: 36px; -fx-font-weight: bold;"/>
                        </VBox>
                        
                        <VBox styleClass="kpi-card" GridPane.columnIndex="1" spacing="15.0">
                            <HBox spacing="15.0" alignment="CENTER_LEFT">
                                <SVGPath content="M12 3L1 9l4 2.18v6L12 21l7-3.82v-6l2-1.09V17h2V9L12 3zm6.82 6L12 12.72 5.18 9 12 5.28 18.82 9zM17 15.99l-5 2.73-5-2.73v-3.72l5 2.73 5-2.73v3.72z" styleClass="svg-icon-purple-large"/>
                                <Label text="Docentes" style="-fx-text-fill: #94A3B8; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                            </HBox>
                            <Label fx:id="lblNumDocentes" text="0" style="-fx-text-fill: #F8FAFC; -fx-font-size: 36px; -fx-font-weight: bold;"/>
                        </VBox>
                        
                        <VBox styleClass="kpi-card" GridPane.columnIndex="2" spacing="15.0">
                            <HBox spacing="15.0" alignment="CENTER_LEFT">
                                <SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" styleClass="svg-icon-purple-large"/>
                                <Label text="Grupos" style="-fx-text-fill: #94A3B8; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                            </HBox>
                            <Label fx:id="lblNumGrupos" text="0" style="-fx-text-fill: #F8FAFC; -fx-font-size: 36px; -fx-font-weight: bold;"/>
                        </VBox>
                        
                        <VBox styleClass="kpi-card" GridPane.columnIndex="3" spacing="15.0">
                            <HBox spacing="15.0" alignment="CENTER_LEFT">
                                <SVGPath content="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z" styleClass="svg-icon-cyan-large"/>
                                <Label text="Asignaturas" style="-fx-text-fill: #94A3B8; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                            </HBox>
                            <Label fx:id="lblNumAsignaturas" text="0" style="-fx-text-fill: #F8FAFC; -fx-font-size: 36px; -fx-font-weight: bold;"/>
                        </VBox>
                    </GridPane>
                    
                    <VBox style="-fx-padding: 10 0 0 0;">
                        <Label text="Actividad Reciente" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #F8FAFC; -fx-padding: 0 0 15 0;"/>
                        <VBox styleClass="glass-card" alignment="CENTER" maxHeight="-Infinity" prefHeight="100.0" style="-fx-padding: 30px;">
                            <Label text="No hay actividad reciente registrada." style="-fx-text-fill: #64748B; -fx-font-size: 14px; -fx-font-style: italic;"/>
                        </VBox>
                    </VBox>

                </VBox>
            </ScrollPane>
        </StackPane>
    </center>
</BorderPane>
