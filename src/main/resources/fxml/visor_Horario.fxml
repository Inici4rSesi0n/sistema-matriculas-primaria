<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="presentacion.controlador.visor_HorarioController"
            styleClass="visor-root">
   <stylesheets>
        <URL value="@/css/visor_Horarios.css" />
    </stylesheets>
    <top>
        <VBox spacing="15.0" styleClass="visor-header">
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
            </padding>
            <HBox alignment="CENTER_LEFT">
                <Label styleClass="visor-title" text="Visualización de Horario" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnCerrarVisor" text="✕" styleClass="visor-close-btn" onAction="#handleCerrar" />
            </HBox>
            <HBox spacing="15.0" alignment="CENTER_LEFT">
                <Label text="Grupo:" styleClass="formulario-label" />
                <ComboBox fx:id="cmbGrupoVisor" promptText="Seleccione un grupo" styleClass="formulario-input" prefWidth="300.0" />
                <Label text="Periodo:" styleClass="formulario-label" />
                <ComboBox fx:id="cmbPeriodoVisor" promptText="Seleccione un periodo" styleClass="formulario-input" prefWidth="300.0" />
                <Button fx:id="btnGenerarHorario" text="Generar Horario" styleClass="boton-primario" onAction="#handleGenerarHorario" />
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <TableView fx:id="tablaHorario" styleClass="visor-tabla">
                <columns>
                    <TableColumn fx:id="colDia" text="Día" prefWidth="100.0" styleClass="col-center" />
                    <TableColumn fx:id="colHoraInicio" text="Hora Inicio" prefWidth="100.0" styleClass="col-center" />
                    <TableColumn fx:id="colHoraFin" text="Hora Fin" prefWidth="100.0" styleClass="col-center" />
                    <TableColumn fx:id="colTipo" text="Tipo" prefWidth="100.0" styleClass="col-center" />
                    <TableColumn fx:id="colAsignaturaHorario" text="Asignatura" prefWidth="200.0" />
                    <TableColumn fx:id="colDocenteHorario" text="Docente" prefWidth="200.0" />
                    <TableColumn fx:id="colAulaHorario" text="Aula" prefWidth="100.0" />
                    <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="200.0" />
                </columns>
            </TableView>
        </ScrollPane>
    </center>
</BorderPane>