<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="root" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="presentacion.controlador.TabAsignacionesController">
    <center>
        <VBox spacing="15.0" style="-fx-padding: 20px;">
            <HBox styleClass="crud-header" alignment="CENTER_LEFT">
                <Label text="Asignación de Asignaturas a Docente" styleClass="crud-title" style="-fx-font-size: 20px;"/>
            </HBox>
            <HBox spacing="15.0" alignment="CENTER_LEFT" style="-fx-padding: 0 0 10 0;">
                <ComboBox fx:id="cmbDocenteAsignatura" promptText="Seleccione un docente" styleClass="formulario-input" prefWidth="300.0" />
                <ComboBox fx:id="cmbAsignaturaDocente" promptText="Seleccione una asignatura" styleClass="formulario-input" prefWidth="300.0" />
                <Button fx:id="btnAgregarAsignaturaDocente" text="+ Agregar Asignatura" styleClass="boton-primario" onAction="#handleAgregarAsignaturaDocente" />
            </HBox>
            <VBox styleClass="tabla-wrapper" VBox.vgrow="ALWAYS">
                <TableView fx:id="tablaAsignaturasDocente" styleClass="seccion-tabla" VBox.vgrow="ALWAYS">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colCodigoDocenteAsignatura" text="Código Docente" prefWidth="150.0" />
                        <TableColumn fx:id="colNombreDocenteAsignatura" text="Nombre Docente" prefWidth="250.0" />
                        <TableColumn fx:id="colAsignaturaDocente" text="Asignatura" prefWidth="250.0" />
                        <TableColumn fx:id="colAccionesAsignaturaDocente" text="Acciones" prefWidth="100.0" />
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>
