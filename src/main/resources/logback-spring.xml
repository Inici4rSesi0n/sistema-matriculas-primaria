<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <property name="PATRON_AUDIT"  value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%X{usuario:--}] %msg%n"/>
    <property name="PATRON_ERROR"  value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger - %msg%n%ex"/>
    <property name="PATRON_SQL"    value="%d{HH:mm:ss.SSS} [SQL] %msg%n"/>
    <property name="PATRON_CONSOLE" value="%d{HH:mm:ss.SSS} [%X{usuario:--}] %-5level %logger{36} - %msg%n"/>
    <property name="LOG_DIR"       value="${WIREDACADEMY_LOG_DIR:-./logs}"/>

    <!-- =========================================================
         APPENDERS DE ARCHIVO (Siempre activos)
         ========================================================= -->
    <appender name="AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/wiredacademy-audit.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/wiredacademy-audit-%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>90</maxHistory>
        </rollingPolicy>
        <encoder><pattern>${PATRON_AUDIT}</pattern></encoder>
    </appender>

    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/wiredacademy-error.log</file>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/wiredacademy-error-%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder><pattern>${PATRON_ERROR}</pattern></encoder>
    </appender>

    <appender name="EVENTBUS_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/wiredacademy-eventbus.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/wiredacademy-eventbus-%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>15</maxHistory>
        </rollingPolicy>
        <encoder><pattern>${PATRON_ERROR}</pattern></encoder>
    </appender>

    <appender name="SQL_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/wiredacademy-sql.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/wiredacademy-sql-%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder><pattern>${PATRON_SQL}</pattern></encoder>
    </appender>

    <appender name="APP_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/wiredacademy-app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/wiredacademy-app-%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder><pattern>${PATRON_ERROR}</pattern></encoder>
    </appender>

    <!-- =========================================================
         APPENDER DE CONSOLA
         ========================================================= -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder><pattern>${PATRON_CONSOLE}</pattern></encoder>
    </appender>

    <!-- =========================================================
         PERFIL DEV — Consola limpia + Archivos
         ========================================================= -->
    <springProfile name="dev">
        <!-- Hibernate va SOLO al archivo SQL, no ensucia la consola -->
        <logger name="org.hibernate.SQL" level="DEBUG" additivity="false">
            <appender-ref ref="SQL_FILE"/>
        </logger>
        <logger name="org.hibernate.orm.jdbc.bind" level="TRACE" additivity="false">
            <appender-ref ref="SQL_FILE"/>
        </logger>
        <logger name="org.springframework" level="WARN"/>

        <!-- AUDIT: consola + archivo permanente -->
        <logger name="WiredAcademy.AUDIT" level="INFO" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="AUDIT_FILE"/>
        </logger>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ERROR_FILE"/>
            <appender-ref ref="APP_FILE"/>
        </root>

        <logger name="WiredAcademy.EVENTBUS" level="DEBUG" additivity="false">
            <appender-ref ref="EVENTBUS_FILE"/>
        </logger>
        <logger name="WiredAcademy.UI" level="TRACE" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="APP_FILE"/>
        </logger>
    </springProfile>

    <!-- =========================================================
         PERFIL PROD — Solo archivos (sin consola)
         ========================================================= -->
    <springProfile name="prod">
        <logger name="org.hibernate" level="WARN"/>
        <logger name="org.springframework" level="WARN"/>

        <logger name="WiredAcademy.AUDIT" level="INFO" additivity="false">
            <appender-ref ref="AUDIT_FILE"/>
        </logger>
        <logger name="WiredAcademy.EVENTBUS" level="INFO" additivity="false">
            <appender-ref ref="EVENTBUS_FILE"/>
        </logger>
        <logger name="WiredAcademy.UI" level="OFF"/>

        <root level="INFO">
            <appender-ref ref="ERROR_FILE"/>
            <appender-ref ref="APP_FILE"/>
        </root>
    </springProfile>

</configuration>
